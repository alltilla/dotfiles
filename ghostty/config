command = /opt/homebrew/bin/fish

font-family = MesloLGS NF
font-size = 13
#alpha-blending = linear-corrected
scrollbar = never
window-save-state = always

cursor-style = block
cursor-style-blink = true
shell-integration-features = no-cursor,ssh-env,ssh-terminfo

background = 1e1e1e
foreground = d3d7cf
bold-is-bright = true

palette = 0=#2e3436
palette = 1=#cc0000
palette = 2=#4e9a06
palette = 3=#c4a000
palette = 4=#3465a4
palette = 5=#75507b
palette = 6=#06989a
palette = 7=#d3d7cf
palette = 8=#555753
palette = 9=#ef2929
palette = 10=#8ae234
palette = 11=#fce94f
palette = 12=#729fcf
palette = 13=#ad7fa8
palette = 14=#34e2e2
palette = 15=#eeeeec

unfocused-split-opacity = 0.5
unfocused-split-fill = 000000
split-divider-color = 555753
custom-shader = /Users/alltilla/.config/ghostty/shaders/desaturate-unfocused.glsl
custom-shader-animation = false

keybind = ctrl+shift+right=new_split:right
keybind = ctrl+shift+down=new_split:down
keybind = ctrl+shift+left=close_surface
keybind = ctrl+shift+up=toggle_split_zoom

keybind = shift+left=goto_split:left
keybind = shift+right=goto_split:right
keybind = shift+up=goto_split:up
keybind = shift+down=goto_split:down

keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard
